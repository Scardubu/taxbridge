              "raw": "{\n  \"amount\": 1000000,\n  \"type\": \"consultancy\"\n}"
            }
          }
        },
        {
          "name": "Calculate PAYE",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/{{api_version}}/tax/calculate/paye",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grossSalary\": 500000,\n  \"allowances\": {\n    \"housing\": 100000,\n    \"transport\": 50000,\n    \"meal\": 30000,\n    \"others\": 20000\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Invoice Management",
      "item": [
        {
          "name": "Create Invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('invoice_id', response.data.invoice.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/{{api_version}}/invoice-mgmt",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"ABC Corporation\",\n    \"email\": \"accounts@abc.com\",\n    \"phone\": \"+2348087654321\",\n    \"tin\": \"87654321-0001\",\n    \"address\": \"456 Business Ave, Abuja\"\n  },\n  \"items\": [\n    {\n      \"description\": \"Web Development Services\",\n      \"quantity\": 1,\n      \"unitPrice\": 500000,\n      \"vatApplicable\": true\n    },\n    {\n      \"description\": \"Hosting (Annual)\",\n      \"quantity\": 1,\n      \"unitPrice\": 50000,\n      \"vatApplicable\": true\n    }\n  ],\n  \"dueDate\": \"2026-03-15\",\n  \"nrsCompliant\": true\n}"
            }
          }
        },
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/invoice-mgmt?status=SENT&page=1&limit=20",
