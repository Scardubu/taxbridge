          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/{{api_version}}/business/profile"
          }
        },
        {
          "name": "Update Business Profile",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/{{api_version}}/business/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Trading Limited\",\n  \"phone\": \"+2348087654321\"\n}"
            }
