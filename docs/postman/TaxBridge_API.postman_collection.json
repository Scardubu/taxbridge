              "mode": "raw",
              "raw": "{\n  \"grossIncome\": 5000000,\n  \"reliefs\": {\n    \"cra\": true,\n    \"pension\": 400000,\n    \"nhf\": 125000,\n    \"lifeInsurance\": 100000\n  }\n}"
            }
          }
        },
