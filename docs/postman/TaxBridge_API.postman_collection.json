          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/{{api_version}}/business",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Trading Ltd\",\n  \"cacNumber\": \"RC123456\",\n  \"tin\": \"12345678-0001\",\n  \"email\": \"info@acmetrading.com\",\n  \"phone\": \"+2348012345678\",\n  \"address\": {\n    \"street\": \"123 Main Street\",\n    \"city\": \"Lagos\",\n    \"state\": \"Lagos\",\n    \"zipCode\": \"100001\"\n  },\n  \"businessType\": \"limited-company\"\n}"
            }
          }
        },
        {
