              "raw": "{\n  \"revenue\": 50000000,\n  \"expenses\": 30000000\n}"
            }
          }
        },
        {
          "name": "Calculate CGT",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/{{api_version}}/tax/calculate/cgt",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proceeds\": 5000000,\n  \"costBasis\": 3000000,\n  \"assetType\": \"crypto\"\n}"
