# ─────────────────────────────────────────────────────────────────────────────
# TaxBridge — Environment Variables Reference  (COMP-04)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (or a per-environment .env.<env> file) and fill in
# real values. NEVER commit a file that contains actual secrets.
# See docs/DEPLOYMENT_GUIDE.md for per-environment setup instructions.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────

# Full postgres:// connection string required
# Example: postgresql://taxbridge:secret@localhost:5432/taxbridge_dev
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ── Redis ─────────────────────────────────────────────────────────────────────

# Full redis:// or rediss:// (TLS) connection string
# Example: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Auth & JWT ────────────────────────────────────────────────────────────────

# 256-bit randomly generated secret — never reuse across environments
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Multi-factor Auth ─────────────────────────────────────────────────────────

MFA_ISSUER=TaxBridge
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# ── Encryption / Keys ─────────────────────────────────────────────────────────

# AES-256-GCM key for PII field encryption (TIN, NIN, BVN, etc.)
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# ECDSA private key for signing UBL invoices (base64-encoded PEM)
ECDSA_PRIVATE_KEY=REPLACE_WITH_BASE64_PEM

# ── DigiTax / NRS Access Point Provider ──────────────────────────────────────
# C-02: No direct NRS/FIRS integration. All e-invoice submissions go through
# an NITDA-accredited Access Point Provider (APP). Currently: DigiTax.

DIGITAX_API_URL=https://api.digitax.ng/v1
DIGITAX_API_KEY=REPLACE_WITH_DIGITAX_KEY
DIGITAX_CLIENT_ID=REPLACE_WITH_CLIENT_ID
DIGITAX_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# ── Remita ────────────────────────────────────────────────────────────────────
# Never trust frontend payment state — Remita webhook required for confirmation.

REMITA_BASE_URL=https://login.remita.net/remita/exapp/api/v1/send
REMITA_MERCHANT_ID=REPLACE_WITH_MERCHANT_ID
REMITA_API_KEY=REPLACE_WITH_API_KEY
REMITA_SERVICE_TYPE_ID=REPLACE_WITH_SERVICE_TYPE_ID

# ── Flutterwave ───────────────────────────────────────────────────────────────

FLUTTERWAVE_SECRET_KEY=REPLACE_WITH_SECRET_KEY
FLUTTERWAVE_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY
FLUTTERWAVE_WEBHOOK_HASH=REPLACE_WITH_WEBHOOK_HASH

# ── Africa's Talking (SMS / USSD) ────────────────────────────────────────────

AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=REPLACE_WITH_AT_API_KEY
AFRICAS_TALKING_USSD_CODE=*384*XXXXX#

# ── Sentry ────────────────────────────────────────────────────────────────────

SENTRY_DSN=REPLACE_WITH_SENTRY_DSN
SENTRY_ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. NEVER use * in production.

ALLOWED_ORIGINS=http://localhost:3001,http://localhost:19006

# ── Monitoring / Observability ───────────────────────────────────────────────

RENDER_API_KEY=REPLACE_WITH_RENDER_API_KEY

# ── Mobile (Expo) — exposed via EXPO_PUBLIC_ prefix ──────────────────────────

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=REPLACE_WITH_MOBILE_SENTRY_DSN

# ── Admin Dashboard (Next.js) — public vars ───────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TaxBridge Admin

# ── Rate Limiting ─────────────────────────────────────────────────────────────

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ── Misc ──────────────────────────────────────────────────────────────────────

OCR_CONFIDENCE_THRESHOLD=0.70
ENABLE_TEST_ROUTES=false
