# TaxBridge Production Environment Configuration Template
# Copy this to .env.production and populate with actual credentials

# ======================
# Server Configuration
# ======================
NODE_ENV=production
PORT=3000

# ======================
# Render Deployment (Staging + Production)
# ======================
RENDER_API_BASE_URL=https://api.render.com/v1
RENDER_SERVICE_ID=srv-d62gsicr85hc73a34nc0
RENDER_DASHBOARD_URL=https://dashboard.render.com
RENDER_SERVICE_URL=https://taxbridge-api-ker8.onrender.com
RENDER_DEPLOY_BRANCH=master
# Export RENDER_API_TOKEN from secure secrets manager before running infra/scripts/render-deploy.mjs
RENDER_API_TOKEN=

# ======================
# Database (Supabase Pro)
# ======================
# Note: If your password contains special characters (e.g. @, :, /, ?), URL-encode it first.
# Example: node -e "console.log(encodeURIComponent('p@ss:word'))"
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# ======================
# Redis Cache (Redis Cloud / Render Redis)
# ======================
# Redis Cloud format (with TLS on port 15968):
# REDIS_URL=redis://default:YOUR_PASSWORD@redis-XXXXX.crce199.us-west-2-2.ec2.cloud.redislabs.com:15968
# Render Redis format (standard port 6379):
# REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379
REDIS_OPTIONAL=false

# ======================
# Duplo/DigiTax (NITDA-accredited APP for NRS e-invoicing)
# ======================
# Note: Backend uses DUPLO_CLIENT_ID/SECRET (OAuth 2.0 credentials)
# OAuth 2.0 Client Credentials
DUPLO_CLIENT_ID=your_production_client_id_here
DUPLO_CLIENT_SECRET=your_production_client_secret_here
DUPLO_API_URL=https://api.duplo.co

# DigiTax settings (if using separate DigiTax API)
DIGITAX_API_URL=https://api.digitax.ng
DIGITAX_API_KEY=your_digitax_api_key
DIGITAX_HMAC_SECRET=your_digitax_hmac_secret
DIGITAX_MOCK_MODE=false

# ======================
# Remita Payment Gateway
# ======================
# Backend expects REMITA_API_URL (not REMITA_BASE_URL)
REMITA_API_URL=https://login.remita.net
REMITA_MERCHANT_ID=your_merchant_id_here
REMITA_API_KEY=your_production_api_key_here
REMITA_SERVICE_TYPE_ID=your_service_type_id_here
REMITA_WEBHOOK_SECRET=generate_random_32_char_string
REMITA_MOCK_MODE=false

# ======================
# UBL 3.0 Validation
# ======================
UBL_XSD_PATH=lib/ubl-invoice-2.1.xsd

# ======================
# SMS/USSD Providers
# ======================
# Primary provider: africastalking, infobip, or termii
COMMS_PROVIDER=africastalking

# Africa's Talking
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username
AT_SHORTCODE=your_short_code

# Infobip (optional)
INFOBIP_API_KEY=your_infobip_api_key
INFOBIP_API_URL=https://api.infobip.com
INFOBIP_SIGNATURE_SECRET=your_infobip_webhook_secret
INFOBIP_SENDER=TaxBridge

# Termii (optional)
TERMII_API_KEY=your_termii_api_key
TERMII_API_URL=https://v3.api.termii.com
TERMII_SIGNATURE_SECRET=your_termii_webhook_secret
TERMII_SENDER=TaxBridge

# ======================
# Flutterwave Payment Gateway
# ======================
FLW_PUBLIC_KEY=FLWPUBK-...
FLW_SECRET_KEY=FLWSECK-...
FLW_SECRET_HASH=your_flutterwave_secret_hash
FLW_ENCRYPTION_KEY=your_flutterwave_encryption_key
FLW_BASE_URL=https://api.flutterwave.com
FLW_MOCK_MODE=false

# ======================
# Paystack Payment Gateway
# ======================
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_MOCK_MODE=false

# ======================
# Payment Gateway Selection
# ======================
PRIMARY_PAYMENT_GATEWAY=flutterwave
FALLBACK_PAYMENT_GATEWAY=paystack

# ======================
# Youverify (Business Verification)
# ======================
YOUVERIFY_API_KEY=your_youverify_api_key
YOUVERIFY_BASE_URL=https://api.youverify.co
YOUVERIFY_SANDBOX=false

# ======================
# Security
# ======================
# Comma-separated list of allowed origins for CORS
# Include both custom domain and platform URLs
ALLOWED_ORIGINS=https://taxbridge.ng,https://app.taxbridge.ng,https://admin.taxbridge.ng,https://taxbridge.vercel.app

# JWT Authentication (REQUIRED)
# Generate with: node backend/scripts/generate-secrets.js
JWT_SECRET=
JWT_REFRESH_SECRET=

# Data Encryption (REQUIRED)
# Used for encrypting TIN, NIN, and API credentials at rest
# Generate with: node backend/scripts/generate-secrets.js
ENCRYPTION_KEY=

# Session & Webhooks
# Generate with: node backend/scripts/generate-secrets.js
SESSION_SECRET=
WEBHOOK_SECRET=

# SMS webhook signature verification (1=enabled, 0=disabled)
REQUIRE_SMS_SIGNATURE=1

# ======================
# Features
# ======================
# Enable/disable deadline reminder cron jobs
ENABLE_DEADLINE_REMINDERS=true

# Enable device sync and admin diagnostics (Phase 4-6)
FEATURE_DEVICE_SYNC=true

# Start payment worker in-process (false for separate worker service)
START_PAYMENT_WORKER=false

# Phase 6 Features
# Payroll, Compliance Alerts, Crypto Tax, Reconciliation
# All enabled by default — no additional env vars required
# Compliance reminders auto-generate based on NTA 2025 calendar
# Crypto tax uses FIFO cost basis and 10% CGT rate

# Test phone number for SMS testing (optional)
TEST_PHONE_NUMBER=

# ======================
# Monitoring & Observability
# ======================
ENABLE_METRICS=true
METRICS_INTERVAL=60000

# Sentry Error Tracking & APM
# Required: Sign up at sentry.io and get your DSN
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# Uptime Robot API Key (for external monitoring)
# Get from: https://uptimerobot.com/dashboard#mySettings
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_ALERT_CONTACTS=

# ======================
# Slack Notifications (optional)
# ======================
SLACK_WEBHOOK_URL=

# ======================
# Container Registry (for deploy.sh)
# ======================
REGISTRY=taxbridge

# ======================
# Admin Dashboard
# ======================
# Used by admin-dashboard Next.js app for backend API calls
# Admin dashboard reads BACKEND_URL or NEXT_PUBLIC_BACKEND_URL
# Use the actual Render URL until custom domain (api.taxbridge.ng) DNS is configured
BACKEND_URL=https://taxbridge-api-ker8.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://taxbridge-api-ker8.onrender.com

# Admin API keys (comma-separated for rotation)
# Must match ADMIN_API_KEYS in backend environment
ADMIN_API_KEYS=production_admin_key_1,production_admin_key_2

# Admin dashboard also needs NEXT_PUBLIC_ADMIN_API_KEY for client-side calls
# WARNING: This is exposed to browser - use only for read-only operations
# Consider moving mutations to Next.js server actions (Phase 8 recommendation)
NEXT_PUBLIC_ADMIN_API_KEY=production_readonly_admin_key

# ======================
# Mobile App
# ======================
# Used by mobile Expo app for backend API calls
# Mobile reads EXPO_PUBLIC_API_URL from mobile/.env
# Use the actual Render URL until custom domain (api.taxbridge.ng) DNS is configured
EXPO_PUBLIC_API_URL=https://taxbridge-api-ker8.onrender.com

# ======================
# Instructions
# ======================
# 1. Copy this file: cp .env.production.example .env.production
# 2. Generate secrets:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Obtain Duplo production credentials from DigiTax account
# 4. Obtain Remita merchant credentials from Remita dashboard
# 5. Set up Supabase Pro database and copy connection string
# 6. Set up Render Redis and copy connection string
# 7. Configure SMS provider (Africa's Talking recommended for Nigeria)
# 8. Never commit .env.production to version control
# Rate Limiting (15 variables)
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_API_MAX=100
# ... (see .env.example)

# Monitoring (9 variables)
ENABLE_DLQ_MONITORING=true
ENABLE_POOL_MONITORING=true
DLQ_THRESHOLD_INVOICE_SYNC=10
# ... (see .env.example)

# Connection Pooling
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=5000
PRISMA_SLOW_QUERY_MS=500