{
  "cli": {
    "version": ">= 13.2.3",
    "appVersionSource": "remote",
    "requireCommit": true,
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "cache": {
        "disabled": true,
        "key": "v7-{{os}}-{{arch}}-{{runtimeVersion}}-{{workflow}}-{{checksum:package-lock.json}}-{{checksum:app.json}}-{{timestamp}}"
      },
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EAS_BUILD_DISABLE_MAVEN_CACHE": "1",
        "EAS_BUILD_DISABLE_GRADLE_CACHE": "1",
        "METRO_CACHE_DISABLED": "1",
        "EXPO_USE_FAST_RESOLVER": "1",
        "CI": "1"
      },
      "distribution": "internal"
    },
    "development": {
      "extends": "base",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug --no-daemon --no-build-cache --stacktrace"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://taxbridge-api-ker8.onrender.com"
      }
    },
    "preview": {
      "extends": "base",
      "cache": {
        "disabled": true,
        "clear": true
      },
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease --no-daemon --no-build-cache --rerun-tasks --refresh-dependencies --stacktrace"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://taxbridge-api-ker8.onrender.com"
      }
    },
    "production": {
      "extends": "base",
      "cache": {
        "disabled": true,
        "clear": true
      },
      "distribution": "store",
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease --no-daemon --no-build-cache --rerun-tasks --refresh-dependencies --stacktrace --warning-mode all"
      },
      "ios": {
        "buildConfiguration": "Release",
        "autoIncrement": "buildNumber"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://taxbridge-api-ker8.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./android/service-account.json",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    }
  }
}
