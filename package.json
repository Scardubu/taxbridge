{
  "name": "taxbridge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "admin",
    "admin-dashboard",
    "backend",
    "ml/ocr_service",
    "packages/*",
    "prompts"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "type-check": "npx tsc --noEmit",
    "fix:expo": "npm --prefix mobile run fix:expo",
    "fix:ai": "npx tsx scripts/ai-fix.ts",
    "fix:apk": "npx tsx scripts/ai-build.ts",
    "type-check:mobile": "npm --prefix mobile run type-check",
    "type-check:admin": "npm run type-check --workspace=admin-dashboard --if-present",
    "type-check:admin-dashboard": "npm run type-check --workspace=admin-dashboard --if-present",
    "type-check:backend": "npm run type-check --workspace=@taxbridge/backend",
    "build": "npm run build --workspace=@taxbridge/contracts && npm run build --workspace=@taxbridge/backend && npm run build --workspace=admin-dashboard --if-present",
    "prompts:verify": "tsx scripts/verify-prompts.ts",
    "docs:api": "tsx scripts/dump-swagger.ts",
    "backfill:v13": "tsx scripts/backfill-v13.ts",
    "session:checks": "bash scripts/session-checks.sh",
    "accuracy:gates": "tsx scripts/run-accuracy-gates.ts",
    "validate:phase": "npm run type-check && npm run accuracy:gates && npm test",
    "integrate:new-files": "powershell -ExecutionPolicy Bypass -File scripts/integrate-new-files.ps1"
  },
  "devDependencies": {
    "next": "16.1.1",
    "typescript": "~5.9.2"
  }
}
