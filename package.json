{
  "name": "taxbridge",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "admin-dashboard",
    "mobile",
    "backend",
    "ml",
    "infra",
    "packages/*",
    "prompts"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "type-check": "cd mobile && npm run type-check && cd ../admin-dashboard && npm run type-check && cd ../backend && npm run type-check",
    "type-check:mobile": "cd mobile && npm run type-check",
    "type-check:admin": "cd admin-dashboard && npm run type-check",
    "type-check:backend": "cd backend && npm run type-check",
    "build": "npm run build --workspace=@taxbridge/contracts && npm run build --workspace=@taxbridge/backend && npm run build --workspace=admin-dashboard",
    "prompts:load": "npm run prompts:load --workspace=@taxbridge/prompts",
    "prompts:build": "npm run prompts:build --workspace=@taxbridge/prompts",
    "prompts:verify": "npm run prompts:verify --workspace=@taxbridge/prompts",
    "prompts:query": "npm run prompts:query --workspace=@taxbridge/prompts"
  },
  "devDependencies": {
    "next": "16.1.1",
    "typescript": "~5.9.2"
  }
}
