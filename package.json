{
  "name": "taxbridge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "20.x"
  },
  "workspaces": {
    "packages": [
      "admin-dashboard",
      "mobile",
      "backend",
      "ml",
      "infra",
      "packages/*"
    ],
    "nohoist": [
      "**/expo",
      "**/expo/**",
      "**/react-native",
      "**/react-native/**",
      "**/expo-*",
      "**/expo-*/**",
      "**/react-native-*",
      "**/react-native-*/**",
      "**/@expo/**",
      "**/@react-native/**",
      "**/@react-navigation/**"
    ]
  },
  "resolutions": {
    "expo-constants": "18.0.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "use-sync-external-store": "1.4.0"
  },
  "scripts": {
    "lint": "yarn workspaces run lint",
    "test": "yarn workspaces run test",
    "build": "yarn workspace @taxbridge/contracts build && yarn workspace @taxbridge/backend build && yarn workspace admin-dashboard build"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
