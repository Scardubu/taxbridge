{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start": "expo start",
    "start:online": "expo start",
    "start:no-doctor": "cross-env EXPO_NO_DOCTOR=1 expo start",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild --clean",
    "check:ui-consistency": "node scripts/ui-consistency-check.js",
    "check:accessibility": "node scripts/accessibility-audit.js",
    "check:post-deploy": "node scripts/post-deployment-check.js",
    "build": "echo 'Mobile: No build needed (Expo builds via EAS)' && exit 0",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:build:apk": "node scripts/ensure-expo-bin.js && cross-env CI=1 npx expo prebuild --platform android --clean && cross-env EAS_NO_VCS=1 EAS_SKIP_AUTO_FINGERPRINT=1 npx eas build --platform android --profile production-apk --clear-cache --non-interactive"
  },
  "dependencies": {
    "@babel/core": "^7.22.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "~11.4.1",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.27",
    "@react-navigation/native-stack": "^7.9.1",
    "@shopify/flash-list": "~2.2.2",
    "@tanstack/react-query": "^5.90.21",
    "@taxbridge/contracts": "file:../packages/contracts",
    "axios": "^1.13.5",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "expo": "~54.0.7",
    "expo-router": "~6.0.4",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.0",
    "react-native-worklets": "~0.5.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "~15.11.2",
    "expo-sqlite": "~15.2.10",
    "expo-secure-store": "~14.2.0",
    "expo-haptics": "~14.0.1",
    "expo-speech": "~13.0.0",
    "expo-sharing": "~13.0.0",
    "expo-file-system": "~18.0.11",
    "expo-crypto": "~14.0.1",
    "expo-device": "~7.0.1",
    "expo-localization": "~16.0.1",
    "react-native-view-shot": "~3.8.0",
    "react-native-sse": "~1.2.0",
    "lottie-react-native": "~7.2.2",
    "nativewind": "~4.2.1",
    "zustand": "~5.0.3",
    "i18next": "~24.2.2",
    "react-i18next": "~15.4.1",
    "@sentry/react-native": "~6.11.0",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "jwt-decode": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.35",
    "@types/react": "~19.1.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^7.0.3",
    "eslint": "~9.23.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.16",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.8.3",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-test-renderer"
      ]
    }
  },
  "private": true
}
