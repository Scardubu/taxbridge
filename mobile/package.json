{
  "name": "mobile",
  "version": "1.4.0",
  "main": "expo-router/entry",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start": "expo start",
    "start:online": "expo start",
    "start:no-doctor": "cross-env EXPO_NO_DOCTOR=1 expo start",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild --clean",
    "check:ui-consistency": "node scripts/ui-consistency-check.js",
    "check:accessibility": "node scripts/accessibility-audit.js",
    "check:post-deploy": "node scripts/post-deployment-check.js",
    "export:android-smoke": "cross-env CI=1 expo export --platform android --output-dir .tmp/eas-metro-smoke",
    "build": "echo 'Mobile: No build needed (Expo builds via EAS)' && exit 0",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node scripts/fix-lightningcss-win32.js",
    "build:contracts": "npm --prefix ../packages/contracts run build",
    "fix:expo": "node scripts/fix-expo-sdk.js",
    "eas:build:apk": "npm run build:contracts && node scripts/fix-expo-sdk.js && node scripts/ensure-expo-bin.js && cross-env CI=1 npx expo prebuild --platform android --clean && node scripts/eas-build-retry.js production-apk",
    "eas:build:apk:retry": "node scripts/eas-build-retry.js production-apk"
  },
  "dependencies": {
    "@babel/core": "^7.22.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "~11.4.1",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@taxbridge/contracts": "file:../packages/contracts",
    "axios": "^1.13.5",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "expo": "~54.0.7",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "i18next": "~24.2.2",
    "jwt-decode": "^4.0.0",
    "lottie-react-native": "~7.3.1",
    "nativewind": "~4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "~15.4.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sse": "~1.2.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "~0.5.1",
    "zustand": "~5.0.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.35",
    "@types/react": "~19.1.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^7.0.3",
    "eslint": "~9.23.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "1.27.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-test-renderer",
        "@react-navigation/bottom-tabs",
        "@react-navigation/native",
        "@react-navigation/native-stack"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": false
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true
}
