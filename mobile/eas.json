{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "local",
    "requireCommit": true,
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "cache": {
        "disabled": true,
        "key": "v7-{{os}}-{{arch}}-{{runtimeVersion}}-{{workflow}}-{{checksum:package-lock.json}}-{{checksum:app.json}}-{{timestamp}}"
      },
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "METRO_CACHE_DISABLED": "1",
        "CI": "1"
      },
      "distribution": "internal",
      "channel": "development"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "${EXPO_PUBLIC_DEV_API_URL}",
        "SENTRY_DSN": "SET_VIA_EAS_SECRET"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "cache": {
        "disabled": true
      },
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://taxbridge-api-ker8.onrender.com",
        "SENTRY_DSN": "SET_VIA_EAS_SECRET"
      }
    },
    "production-apk": {
      "extends": "base",
      "channel": "production-apk",
      "credentialsSource": "local",
      "cache": {
        "disabled": true
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://taxbridge-api-ker8.onrender.com",
        "SENTRY_DSN": "SET_VIA_EAS_SECRET",
        "CI": "1"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "cache": {
        "disabled": true
      },
      "distribution": "store",
      "android": {
          "buildType": "app-bundle",
          "gradleCommand": ":app:bundleRelease"
        },
      "ios": {
        "buildConfiguration": "Release",
        "autoIncrement": "buildNumber"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://taxbridge-api-ker8.onrender.com",
        "SENTRY_DSN": "SET_VIA_EAS_SECRET",
        "CI": "1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./android/service-account.json",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      },
      "ios": {
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleId": "your-apple-id@taxbridge.ng",
        "appleTeamId": "YOUR_TEAM_ID"
      }
    }
  }
}
