# TaxBridge Production Environment Configuration
# Copy to .env.production for production builds

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL (required for production)
# Use the actual Render URL until custom domain (api.taxbridge.ng) DNS is configured
EXPO_PUBLIC_API_URL=https://taxbridge-api-ker8.onrender.com
API_TIMEOUT=30000
API_RETRY_MAX=3

# =============================================================================
# APP METADATA
# =============================================================================
APP_ENV=production
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1

# =============================================================================
# FEATURE FLAGS
# =============================================================================
EXPO_PUBLIC_FEATURE_RECEIPTS_SCANNER=true
EXPO_PUBLIC_FEATURE_OFFLINE_INVOICES=true
EXPO_PUBLIC_FEATURE_TAX_ENGINE_V2=true
EXPO_PUBLIC_FEATURE_DEVICE_SYNC=true
EXPO_PUBLIC_FEATURE_AI_CHATBOT=false
EXPO_PUBLIC_FEATURE_TAX_OPTIMIZER=true
ENABLE_ANALYTICS=true
ENABLE_OCR=true
ENABLE_OFFLINE_MODE=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_CRASH_REPORTING=true

# =============================================================================
# PAYMENT GATEWAYS (Public Keys Only)
# =============================================================================
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# OCR CONFIGURATION
# =============================================================================
OCR_ENGINE=ml_kit  # 'ml_kit' (on-device) or 'tesseract' (offline)
OCR_CONFIDENCE_THRESHOLD=0.7
OCR_MAX_IMAGE_SIZE=5242880  # 5MB

# =============================================================================
# OFFLINE SYNC
# =============================================================================
SYNC_BATCH_SIZE=50
SYNC_RETRY_MAX=5
SYNC_RETRY_DELAY_MS=1000
SYNC_AUTO_INTERVAL_MS=300000  # 5 minutes

# =============================================================================
# ERROR TRACKING (Sentry)
# =============================================================================
EXPO_PUBLIC_SENTRY_DSN=https://60317df8cc81d8b9638feab5c80a3efb@o4510410222010368.ingest.de.sentry.io/4510410226729040
SENTRY_DSN=https://60317df8cc81d8b9638feab5c80a3efb@o4510410222010368.ingest.de.sentry.io/4510410226729040
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# ANALYTICS
# =============================================================================
EXPO_PUBLIC_ANALYTICS_ENABLED=true
MIXPANEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# BIOMETRIC AUTHENTICATION
# =============================================================================
BIOMETRIC_ENABLED=true
BIOMETRIC_FALLBACK_TO_PIN=true

# =============================================================================
# PUSH NOTIFICATIONS
# =============================================================================
PUSH_NOTIFICATIONS_ENABLED=true
EXPO_PROJECT_ID=your-expo-project-id
