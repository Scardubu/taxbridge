# TaxBridge Mobile — Local Development Environment
# Copy to .env for local development
# See .env.production.example for production values

# =============================================================================
# API CONFIGURATION
# =============================================================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
API_TIMEOUT=15000
API_RETRY_MAX=3

# =============================================================================
# APP METADATA
# =============================================================================
APP_ENV=development
EXPO_PUBLIC_ENVIRONMENT=development
APP_VERSION=3.2.4
APP_BUILD_NUMBER=1

# =============================================================================
# FEATURE FLAGS
# =============================================================================
EXPO_PUBLIC_FEATURE_RECEIPTS_SCANNER=true
EXPO_PUBLIC_FEATURE_OFFLINE_INVOICES=true
EXPO_PUBLIC_FEATURE_TAX_ENGINE_V2=true
EXPO_PUBLIC_FEATURE_DEVICE_SYNC=true
EXPO_PUBLIC_FEATURE_AI_CHATBOT=false
EXPO_PUBLIC_FEATURE_TAX_OPTIMIZER=true
EXPO_PUBLIC_ENABLE_ANALYTICS=false
ENABLE_OCR=true
ENABLE_OFFLINE_MODE=true
ENABLE_BIOMETRIC_AUTH=false
ENABLE_PUSH_NOTIFICATIONS=false

# =============================================================================
# PAYMENT GATEWAYS (Test Keys Only)
# =============================================================================
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# OCR CONFIGURATION
# =============================================================================
OCR_ENGINE=ml_kit
OCR_CONFIDENCE_THRESHOLD=0.7
OCR_MAX_IMAGE_SIZE=5242880

# =============================================================================
# OFFLINE SYNC
# =============================================================================
SYNC_BATCH_SIZE=50
SYNC_RETRY_MAX=5
SYNC_RETRY_DELAY_MS=1000
SYNC_AUTO_INTERVAL_MS=300000

# =============================================================================
# ERROR TRACKING (Sentry — disabled in dev)
# =============================================================================
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# =============================================================================
# PUSH NOTIFICATIONS (disabled in dev)
# =============================================================================
PUSH_NOTIFICATIONS_ENABLED=false
