# TaxBridge Mobile v13 Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
EXPO_PUBLIC_API_URL=https://taxbridge-api-ker8.onrender.com
EXPO_PUBLIC_API_VERSION=v1
API_TIMEOUT=15000
API_RETRY_MAX=3

# App Metadata
APP_ENV=development
EXPO_PUBLIC_ENVIRONMENT=development
APP_VERSION=1.3.0
APP_BUILD_NUMBER=1

# Feature Flags
EXPO_PUBLIC_FEATURE_DEVICE_SYNC=false
EXPO_PUBLIC_FEATURE_OFFLINE_FIRST=true
EXPO_PUBLIC_FEATURE_NRS_COMPLIANCE=true
EXPO_PUBLIC_FEATURE_MULTI_CURRENCY=false
EXPO_PUBLIC_FEATURE_RECEIPTS_SCANNER=true
EXPO_PUBLIC_FEATURE_TAX_ENGINE_V2=true
EXPO_PUBLIC_FEATURE_AI_CHATBOT=false
EXPO_PUBLIC_FEATURE_TAX_OPTIMIZER=true
EXPO_PUBLIC_ENABLE_ANALYTICS=false
ENABLE_OCR=true
ENABLE_OFFLINE_MODE=true
ENABLE_BIOMETRIC_AUTH=false
ENABLE_PUSH_NOTIFICATIONS=false

# Authentication
EXPO_PUBLIC_JWT_EXPIRY=24h
EXPO_PUBLIC_REFRESH_TOKEN_EXPIRY=7d

# Tax Authority Configuration
EXPO_PUBLIC_FIRS_BASE_URL=https://api.firs.gov.ng
EXPO_PUBLIC_NRS_PORTAL=https://einvoice.firs.gov.ng

# Payment Gateways (Test Keys)
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
EXPO_PUBLIC_PRIMARY_PAYMENT_GATEWAY=paystack
EXPO_PUBLIC_FALLBACK_PAYMENT_GATEWAY=flutterwave

# Verification Services
EXPO_PUBLIC_YOUVERIFY_API_KEY=
EXPO_PUBLIC_YOUVERIFY_SANDBOX=true

# Storage & Database
EXPO_PUBLIC_SQLITE_DB_NAME=taxbridge_v13.db
EXPO_PUBLIC_STORAGE_PREFIX=taxbridge_v13

# Offline Sync
SYNC_BATCH_SIZE=50
SYNC_RETRY_MAX=5
SYNC_RETRY_DELAY_MS=1000
SYNC_AUTO_INTERVAL_MS=300000

# Localization
EXPO_PUBLIC_DEFAULT_LANGUAGE=en
EXPO_PUBLIC_SUPPORTED_LANGUAGES=en,pid

# OCR Configuration
OCR_ENGINE=ml_kit
OCR_CONFIDENCE_THRESHOLD=0.7
OCR_MAX_IMAGE_SIZE=5242880

# Analytics & Monitoring
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# Development
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=info

# Push Notifications (disabled in dev)
PUSH_NOTIFICATIONS_ENABLED=false
