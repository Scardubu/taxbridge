{
  "expo": {
    "name": "TaxBridge",
    "slug": "taxbridge",
    "version": "1.4.1",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "scheme": "taxbridge",
    "splash": {
      "image": "./assets/icon-square.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "primaryColor": "#FFFFFF",
    "description": "Nigeria's first offline-first, NRS-compliant e-invoicing platform. Create tax-compliant invoices anywhere, sync later. Built for Nigerian SMEs.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.taxbridge.app",
      "buildNumber": "5",
      "infoPlist": {
        "NSCameraUsageDescription": "TaxBridge uses your camera to scan receipts and extract VAT input credits automatically.",
        "NSPhotoLibraryUsageDescription": "TaxBridge can read receipt images from your photo library.",
        "NSPhotoLibraryAddUsageDescription": "TaxBridge needs permission to save scanned receipts to your photo library",
        "NSFaceIDUsageDescription": "TaxBridge uses Face ID for secure, fast login.",
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.developer.associated-domains": [
          "applinks:taxbridge.ng"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "splash": {
        "image": "./assets/icon-square.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-square.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "ng.taxbridge.mobile",
      "versionCode": 15,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "taxbridge.ng",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/icon-square.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "config": {
        "webShortName": "TaxBridge",
        "backgroundColor": "#0B5FFF"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false,
            "kotlinVersion": "2.1.20"
          },
          "ios": {
            "deploymentTarget": "15.1",
            "buildReactNativeFromSource": false
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TaxBridge to scan receipts and invoices with AI-powered OCR"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TaxBridge to import receipts from your photo library"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TaxBridge uses Face ID for secure login."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B5FFF"
        }
      ],
      [
        "expo-sqlite"
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-square.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "owner": "taxbridgeng",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "6.0.0",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "https://taxbridge-api-ker8.onrender.com",
      "sentryDsn": "",
      "environment": "production",
      "eas": {
        "projectId": "5e13f10b-f095-4994-9203-979dc67243fb"
      }
    }
  }
}
