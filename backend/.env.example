# TaxBridge Backend Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Local development with Docker
DATABASE_URL="postgresql://taxbridge:dev_password@localhost:5432/taxbridge_dev"
DIRECT_URL="postgresql://taxbridge:dev_password@localhost:5432/taxbridge_dev"
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=5000

# Supabase (production alternative)
# Note: If your password contains special characters (e.g. @, :, /, ?), URL-encode it.
# Example: encode with Node: node -e "console.log(encodeURIComponent('p@ss:word'))"
# DATABASE_URL="postgresql://postgres:[URL-ENCODED-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?sslmode=require" # pooler
# DIRECT_URL="postgresql://postgres:[URL-ENCODED-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require" # direct (required for Prisma)

# =============================================================================
# REDIS (Queue & Caching)
# =============================================================================
# Local development with Docker (note: port 6380 to avoid conflicts)
REDIS_URL="redis://localhost:6380"

# Redis Cloud (production)
# REDIS_URL="redis://default:CBytrUUreAY0Wn1RmnV54sIPGlXWtz3b@redis-15968.crce199.us-west-2-2.ec2.cloud.redislabs.com:15968"

# Upstash (alternative)
# REDIS_URL="redis://default:[YOUR-PASSWORD]@[HOST].upstash.io:6379"

# =============================================================================
# DIGITAX / APP INTEGRATION (NRS e-Invoicing)
# =============================================================================
DIGITAX_API_URL="https://sandbox.digitax.ng"
DIGITAX_API_KEY="your-digitax-api-key"
DIGITAX_HMAC_SECRET="your-digitax-hmac-secret"
DIGITAX_MOCK_MODE=false

# DigiTax OAuth (if using OAuth flow)
DIGITAX_CLIENT_ID="your-client-id"
DIGITAX_CLIENT_SECRET="your-client-secret"

# =============================================================================
# REMITA INTEGRATION (Payments)
# =============================================================================
REMITA_MOCK_MODE=true
REMITA_API_URL="https://remitademo.net"
REMITA_MERCHANT_ID="your-merchant-id"
REMITA_API_KEY="your-api-key"
REMITA_SERVICE_TYPE_ID="your-service-type-id"
REMITA_WEBHOOK_SECRET="your-remita-webhook-secret"

# =============================================================================
# SMS PROVIDERS
# =============================================================================
# Primary provider: africastalking, infobip, or termii
COMMS_PROVIDER=africastalking

# Africa's Talking
AT_API_KEY="your-at-api-key"
AFRICA_TALKING_API_KEY="your-at-api-key"  # legacy alias
AT_USERNAME="sandbox"
AT_SHORTCODE="TaxBridge"

# Infobip (backup)
INFOBIP_API_KEY="your-infobip-api-key"
INFOBIP_API_URL="https://api.infobip.com"
INFOBIP_SIGNATURE_SECRET="your-infobip-secret"
INFOBIP_SENDER="TaxBridge"

# Termii (backup)
TERMII_API_KEY="your-termii-api-key"
TERMII_API_URL="https://api.ng.termii.com"
TERMII_SIGNATURE_SECRET="your-termii-secret"
TERMII_SENDER="TaxBridge"

# =============================================================================
# TERMII OTP SERVICE (Two-Factor Authentication)
# =============================================================================
TERMII_OTP_ENABLED=true
TERMII_OTP_CHANNEL="generic"
TERMII_OTP_EXPIRY_MINUTES=10
TERMII_OTP_LENGTH=6
TERMII_OTP_TYPE="NUMERIC"

# =============================================================================
# USSD CONFIGURATION
# =============================================================================
USSD_SHORTCODE="*384*2024#"
USSD_CALLBACK_URL="https://api.taxbridge.ng/ussd"

# =============================================================================
# SECURITY
# =============================================================================
# CORS allowed origins (comma-separated) — required by validateEnv.ts
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:19006,http://localhost:8081"
# Legacy alias (kept for backward compat with older middleware)
CORS_ORIGIN="http://localhost:3001,http://localhost:19006,http://localhost:8081"

# Encryption & Authentication
# Generate with: node backend/scripts/generate-secrets.js
ENCRYPTION_KEY="your-64-char-hex-encryption-key"
JWT_SECRET="your-64-char-hex-jwt-secret"
JWT_SECRET_PREVIOUS=""
JWT_REFRESH_SECRET="your-64-char-hex-refresh-secret"
JWT_REFRESH_SECRET_PREVIOUS=""
SESSION_SECRET="your-64-char-session-secret"
WEBHOOK_SECRET="your-64-char-webhook-secret"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Rate limiting
# Rate limiting (configurable thresholds)
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_BLOCK=300
RATE_LIMIT_USSD_WINDOW=60
RATE_LIMIT_USSD_MAX=10
RATE_LIMIT_USSD_BLOCK=300
RATE_LIMIT_SMS_WINDOW=300
RATE_LIMIT_SMS_MAX=5
RATE_LIMIT_SMS_BLOCK=900
RATE_LIMIT_AUTH_WINDOW=900
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_BLOCK=1800
RATE_LIMIT_WEBHOOK_WINDOW=60
RATE_LIMIT_WEBHOOK_MAX=50
RATE_LIMIT_WEBHOOK_BLOCK=300

REQUIRE_SMS_SIGNATURE=0
ENABLE_METRICS=true
METRICS_INTERVAL=30000
PRISMA_SLOW_QUERY_MS=500

# Monitoring
ENABLE_DLQ_MONITORING=true
ENABLE_POOL_MONITORING=true
DLQ_CHECK_INTERVAL_MS=300000
DLQ_THRESHOLD_INVOICE_SYNC=10
DLQ_THRESHOLD_PAYMENT=5
DLQ_THRESHOLD_EMAIL=20
DLQ_THRESHOLD_SMS=15
DLQ_ALERT_WEBHOOK_URL=""
POOL_METRICS_INTERVAL_MS=60000
POOL_UTILIZATION_WARNING=0.8

SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="1.0"

# =============================================================================
# FLUTTERWAVE PAYMENT GATEWAY
# =============================================================================
# Required by validateEnv.ts
FLUTTERWAVE_SECRET="FLWSECK-your-secret-key"
# Additional Flutterwave keys
FLW_PUBLIC_KEY="FLWPUBK-your-key"
FLW_SECRET_KEY="FLWSECK-your-key"
FLW_SECRET_HASH="your-flutterwave-secret-hash"
FLW_ENCRYPTION_KEY="your-flutterwave-encryption-key"
FLW_BASE_URL="https://api.flutterwave.com"
FLW_MOCK_MODE=true

# =============================================================================
# PAYSTACK PAYMENT GATEWAY
# =============================================================================
# Required by validateEnv.ts
PAYSTACK_SECRET="sk_test_your-secret-key"
# Additional Paystack keys
PAYSTACK_SECRET_KEY="sk_test_your-key"
PAYSTACK_PUBLIC_KEY="pk_test_your-key"
PAYSTACK_MOCK_MODE=true

# =============================================================================
# PAYMENT GATEWAY SELECTION
# =============================================================================
PRIMARY_PAYMENT_GATEWAY=flutterwave
FALLBACK_PAYMENT_GATEWAY=paystack

# =============================================================================
# YOUVERIFY (Business Verification)
# =============================================================================
YOUVERIFY_API_KEY="your-youverify-api-key"
YOUVERIFY_BASE_URL="https://api.youverify.co"
YOUVERIFY_SANDBOX=true

# =============================================================================
# CLOUDINARY (File Storage - Invoice PDFs, Receipt Images, Documents)
# =============================================================================
CLOUDINARY_CLOUD_NAME="taxbridge"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-secret"
CLOUDINARY_FOLDER="production"
CLOUDINARY_SECURE=true
MAX_FILE_SIZE=10485760  # 10MB

# =============================================================================
# SENDGRID (Email Service)
# =============================================================================
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="noreply@taxbridge.ng"
FROM_NAME="TaxBridge Nigeria"
SUPPORT_EMAIL="support@taxbridge.ng"

# SendGrid Dynamic Template IDs
INVOICE_EMAIL_TEMPLATE_ID="d-xxxxxxxxxxxxxxxxxxxxxxxx"
RECEIPT_EMAIL_TEMPLATE_ID="d-xxxxxxxxxxxxxxxxxxxxxxxx"
VERIFICATION_EMAIL_TEMPLATE_ID="d-xxxxxxxxxxxxxxxxxxxxxxxx"
PASSWORD_RESET_TEMPLATE_ID="d-xxxxxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# ADMIN
# =============================================================================
# Comma-separated API keys for admin dashboard authentication
ADMIN_API_KEYS="dev-admin-key-1,dev-admin-key-2"
# Development/testing: allow X-Debug-User-Id header (MUST be false in production)
ALLOW_DEBUG_USER_ID_HEADER=false
# Start payment worker in-process (false = separate worker service)
START_PAYMENT_WORKER=false
# Allow port fallback in dev (disabled in production)
ALLOW_PORT_FALLBACK=true

# =============================================================================
# UBL/XML VALIDATION
# =============================================================================
UBL_XSD_PATH="./docs/ubl/UBL-Invoice-3.0.xsd"

# =============================================================================
# FEATURES FLAGS
# =============================================================================
ENABLE_DEADLINE_REMINDERS=true
ENABLE_CACHE_WARMUP=true
CACHE_CLEANUP_INTERVAL=3600000
FEATURE_DEVICE_SYNC=false

# =============================================================================
# QUEUES & WORKERS
# =============================================================================
INVOICE_SYNC_CONCURRENCY=5
INVOICE_SYNC_MAX_ATTEMPTS=5
INVOICE_SYNC_BACKOFF_MS=5000
INVOICE_SYNC_RATE_LIMIT=8
INVOICE_SYNC_RATE_DURATION_MS=1000
INVOICE_SYNC_FAILURE_THRESHOLD=5
INVOICE_SYNC_FAILURE_WINDOW_MS=60000
INVOICE_SYNC_FAILURE_COOLDOWN_MS=60000
INVOICE_SYNC_TIMEOUT_MS=120000
INVOICE_SYNC_LOCK_DURATION_MS=120000
INVOICE_SYNC_REMOVE_ON_COMPLETE=200

PAYMENT_WEBHOOK_CONCURRENCY=3
PAYMENT_WEBHOOK_MAX_ATTEMPTS=4
PAYMENT_WEBHOOK_BACKOFF_MS=3000
PAYMENT_WEBHOOK_TIMEOUT_MS=60000
PAYMENT_WEBHOOK_LOCK_DURATION_MS=60000
PAYMENT_WEBHOOK_REMOVE_ON_COMPLETE=100

# =============================================================================
# BULLMQ ADVANCED QUEUE CONFIGURATION
# =============================================================================
# Email Queue
EMAIL_QUEUE_CONCURRENCY=5
EMAIL_QUEUE_MAX_ATTEMPTS=3
EMAIL_QUEUE_BACKOFF_MS=2000
EMAIL_QUEUE_TIMEOUT_MS=30000
EMAIL_QUEUE_REMOVE_ON_COMPLETE=100

# SMS Queue
SMS_QUEUE_CONCURRENCY=10
SMS_QUEUE_MAX_ATTEMPTS=3
SMS_QUEUE_BACKOFF_MS=1000
SMS_QUEUE_TIMEOUT_MS=15000
SMS_QUEUE_REMOVE_ON_COMPLETE=50

# =============================================================================
# ANALYTICS & TRACKING
# =============================================================================
# Mixpanel
MIXPANEL_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MIXPANEL_PROJECT_ID="xxxxxxx"

# Google Analytics
GA_TRACKING_ID="G-XXXXXXXXXX"
GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Analytics Features
ENABLE_ANALYTICS=true
ANALYTICS_SAMPLE_RATE=1.0

# =============================================================================
# WEBHOOK SECURITY
# =============================================================================
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_RETRY_MAX=3
WEBHOOK_RETRY_DELAY_MS=1000
WEBHOOK_SIGNATURE_ALGORITHM="sha256"

# =============================================================================
# NIGERIAN TAX RATES (Configurable - NTA 2025)
# =============================================================================
# Value Added Tax
VAT_RATE=0.075  # 7.5%
VAT_THRESHOLD=100000000  # ₦100M annual turnover threshold

# Company Income Tax (3-tier system)
CIT_RATE_SMALL=0.00  # 0% for turnover < ₦25M
CIT_RATE_MEDIUM=0.20  # 20% for ₦25M - ₦100M
CIT_RATE_STANDARD=0.30  # 30% for > ₦100M
CIT_THRESHOLD_SMALL=25000000  # ₦25M
CIT_THRESHOLD_MEDIUM=100000000  # ₦100M

# Withholding Tax Rates
WHT_RATE_SERVICES=0.10  # 10% on services
WHT_RATE_RENT=0.10  # 10% on rent
WHT_RATE_DIVIDEND=0.10  # 10% on dividends
WHT_RATE_INTEREST=0.10  # 10% on interest
WHT_RATE_ROYALTY=0.10  # 10% on royalty

# Personal Income Tax (Progressive Rates)
PIT_BRACKET_1_MAX=300000
PIT_BRACKET_1_RATE=0.07
PIT_BRACKET_2_MAX=600000
PIT_BRACKET_2_RATE=0.11
PIT_BRACKET_3_MAX=1100000
PIT_BRACKET_3_RATE=0.15
PIT_BRACKET_4_MAX=1600000
PIT_BRACKET_4_RATE=0.19
PIT_BRACKET_5_MAX=3200000
PIT_BRACKET_5_RATE=0.21
PIT_BRACKET_6_RATE=0.24  # Above ₦3.2M

# PAYE Deductions
PAYE_PENSION_RATE=0.08  # 8% pension contribution
PAYE_NHF_RATE=0.025  # 2.5% National Housing Fund
PAYE_CRA_MIN=200000  # Minimum Consolidated Relief Allowance

# Capital Gains Tax
CGT_RATE=0.10  # 10% on capital gains

# =============================================================================
# NRS / DIGITAX
# =============================================================================
NRS_API_KEY="your-nrs-api-key"
DIGITAX_API_URL="https://sandbox.digitax.ng"
DIGITAX_API_KEY="your-digitax-api-key"
DIGITAX_HMAC_SECRET="your-digitax-hmac-secret"

# =============================================================================
# CLOUDFLARE R2 (enables PDF upload; set DIGITAX_MOCK_MODE=false and R2 keys together)
# =============================================================================
CLOUDFLARE_R2_BUCKET="taxbridge-dev"
CLOUDFLARE_R2_ENDPOINT="https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# =============================================================================
# CBN MONETARY POLICY RATE (Optional — default: 0.2725 = 27.25%)
# Used by penaltyService.ts for interest calculations
# =============================================================================
CBN_MPR=0.2725

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# =============================================================================
# TESTING
# =============================================================================
TEST_PHONE_NUMBER="+2348000000000"

