generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Optional: For connection pooling with Prisma Accelerate
}

model User {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                  String
  nin                    String?  @map("nin")
  smsOptIn               Boolean  @default(false) @map("sms_opt_in")
  name                   String
  tin                    String?
  email                  String?  @unique
  passwordHash           String?  @map("password_hash")
  verificationToken      String?  @map("verification_token")
  verificationTokenExpiry DateTime? @map("verification_token_expiry")
  verified               Boolean  @default(false)
  failedLoginAttempts    Int      @default(0) @map("failed_login_attempts")
  mfaEnabled             Boolean  @default(false) @map("mfa_enabled")
  mfaSecret              String?  @map("mfa_secret")
  mfaTempSecret          String?  @map("mfa_temp_secret")
  lastLoginAt            DateTime? @map("last_login_at")
  lastLoginDevice        String?  @map("last_login_device")
  duploClientId          String?  @map("duplo_client_id")
  duploClientSecret      String?  @map("duplo_client_secret")
  remitaMerchantId       String?  @map("remita_merchant_id")
  remitaApiKey           String?  @map("remita_api_key")
  ecdsaPrivateKey        String?  @map("ecdsa_private_key")
  role                   String   @default("owner") // admin | owner | accountant | employee | viewer
  deleted                Boolean  @default(false)
  deletedAt              DateTime? @map("deleted_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  invoices               Invoice[]
  auditLogs              AuditLog[]
  consents               UserConsent[]
  devices                Device[]
  adminActions           AdminAction[]
  businesses             Business[]
  streakRecord           StreakRecord?
  pillarScores           PillarScore[]

  @@unique([phone], map: "users_phone_unique")
  @@map("users")
}

// ============================================
// Business Entity (separate from User)
// ============================================

enum BusinessStatus {
  PENDING
  VERIFIED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BusinessType {
  SOLE_PROPRIETOR
  PARTNERSHIP
  LIMITED_COMPANY
  NGO
}

model Business {
  id              String          @id @default(uuid()) @db.Uuid
  ownerId         String          @map("owner_id") @db.Uuid
  name            String
  cacNumber       String?         @unique @map("cac_number")
  tin             String?         @unique
  bvn             String?
  email           String?
  phone           String?
  addressStreet   String?         @map("address_street")
  addressCity     String?         @map("address_city")
  addressState    String?         @map("address_state")
  addressZipCode  String?         @map("address_zip_code")
  businessType    BusinessType    @default(SOLE_PROPRIETOR) @map("business_type")
  status          BusinessStatus  @default(PENDING)

  // Verification details (from Youverify)
  tinVerified     Boolean         @default(false) @map("tin_verified")
  bvnVerified     Boolean         @default(false) @map("bvn_verified")
  cacVerified     Boolean         @default(false) @map("cac_verified")
  verifiedAt      DateTime?       @map("verified_at")

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  owner           User            @relation(fields: [ownerId], references: [id])
  invoices        Invoice[]
  employees       Employee[]
  expenses        Expense[]
  taxRemittances  TaxRemittance[]

  @@index([ownerId])
  @@index([tin])
  @@index([status])
  @@index([cacNumber])
  @@map("businesses")
}

// ============================================
// Employee (for Payroll / PAYE)
// ============================================

model Employee {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  name            String
  email           String?
  phone           String?
  tin             String?   @map("tin")
  grossSalary     Decimal   @db.Decimal(15, 2) @map("gross_salary")
  housingAllowance  Decimal @default(0) @db.Decimal(15, 2) @map("housing_allowance")
  transportAllowance Decimal @default(0) @db.Decimal(15, 2) @map("transport_allowance")
  mealAllowance   Decimal   @default(0) @db.Decimal(15, 2) @map("meal_allowance")
  otherAllowances Decimal   @default(0) @db.Decimal(15, 2) @map("other_allowances")
  annualRentPaid  Decimal   @default(0) @db.Decimal(15, 2) @map("annual_rent_paid")
  pensionOptOut   Boolean   @default(false) @map("pension_opt_out")
  startDate       DateTime  @map("start_date")
  status          String    @default("active") // active, inactive, suspended
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business        Business  @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([status])
  @@map("employees")
}

// ============================================
// Expense Tracking
// ============================================

model Expense {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  amount          Decimal   @db.Decimal(15, 2)
  category        String
  description     String
  date            DateTime
  vatAmount       Decimal   @default(0) @db.Decimal(15, 2) @map("vat_amount")
  vatEligible     Boolean   @default(false) @map("vat_eligible")
  receiptImage    String?   @map("receipt_image") @db.Text
  ocrData         Json?     @map("ocr_data")
  status          String    @default("pending") // pending, approved, rejected
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business        Business  @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([category])
  @@index([status])
  @@index([date])
  @@map("expenses")
}

// ============================================
// Tax Remittance Tracking
// ============================================

model TaxRemittance {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  taxType         String    @map("tax_type") // PIT, VAT, CIT, CGT, WHT, PAYE
  period          String    // e.g. "2026-02" or "2025"
  amount          Decimal   @db.Decimal(15, 2)
  status          String    @default("pending") // pending, processing, success, failed
  reference       String?   // Remita RRR or payment reference
  paidAt          DateTime? @map("paid_at")
  filingDeadline  DateTime? @map("filing_deadline")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business        Business  @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([taxType])
  @@index([status])
  @@index([period])
  @@map("tax_remittances")
}

model Invoice {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  businessId         String?  @map("business_id") @db.Uuid
  invoiceNumber      String?  @unique @map("invoice_number")
  customerName       String?  @map("customer_name")
  customerTIN        String?  @map("customer_tin")
  customerEndpointId String?  @map("customer_endpoint_id")
  customerEmail      String?  @map("customer_email")
  customerPhone      String?  @map("customer_phone")
  customerAddress    String?  @map("customer_address")
  status             String   @default("queued") // draft, queued, processing, stamped, sent, paid, overdue, cancelled, failed
  subtotal           Decimal  @db.Decimal(12, 2)
  vat                Decimal  @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  items              Json
  dueDate            DateTime? @map("due_date")
  template           String   @default("professional") // professional, retail, service, wholesale
  ublXml             String?  @map("ubl_xml") @db.Text
  nrsReference       String?  @map("nrs_reference")
  nrsCompliant       Boolean  @default(false) @map("nrs_compliant")
  nrsCSID            String?  @map("nrs_csid")
  nrsIRN             String?  @map("nrs_irn")
  qrCode             String?  @map("qr_code") @db.Text
  pdfUrl             String?  @map("pdf_url")
  notes              String?  @db.Text
  version            Int      @default(1) // For conflict detection
  sentAt             DateTime? @map("sent_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id])
  business     Business? @relation(fields: [businessId], references: [id])

  syncQueue    SyncQueue[]
  payments     Payment[]
  versions     InvoiceVersion[]
  conflicts    Conflict[]
  syncJobs     SyncJob[]

  // Performance indexes for common query patterns
  @@index([status])                    // Filter by invoice status (queued, stamped, failed)
  @@index([userId])                    // List user's invoices
  @@index([businessId])                // List business invoices
  @@index([createdAt])                 // Recent invoices sorting
  @@index([nrsReference])              // Lookup by NRS reference
  @@index([nrsIRN])                    // Lookup by NRS IRN
  @@index([status, userId])            // User's invoices by status
  @@index([userId, updatedAt])         // Sync pull performance (delta updates)
  @@index([dueDate, status])           // Overdue invoice detection
  @@map("invoices")
}

model SyncQueue {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId  String   @map("invoice_id") @db.Uuid
  status     String
  retryCount Int      @default(0) @map("retry_count")
  error      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  invoice    Invoice  @relation(fields: [invoiceId], references: [id])

  // Performance indexes for queue processing
  @@index([status])                    // Filter pending sync items
  @@index([invoiceId])                 // Lookup by invoice
  @@index([status, retryCount])        // Find items ready for retry
  @@map("sync_queue")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action    String
  userId    String?  @map("user_id") @db.Uuid
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  // Performance indexes for audit queries
  @@index([userId])                    // User's audit trail
  @@index([action])                    // Filter by action type
  @@index([createdAt])                 // Recent activity
  @@map("audit_logs")
}

model IdempotencyCache {
  key          String   @id
  requestHash  String   @map("request_hash")
  method       String
  path         String
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("idempotency_cache")
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  gateway        String   @default("remita") // remita, paystack, flutterwave
  rrr            String   @unique // Remita RRR or gateway reference
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("pending") // pending, processing, paid, failed, refunded
  payerName      String
  payerEmail     String
  payerPhone     String
  transactionRef String?
  gatewayRef     String?  @map("gateway_ref") // Gateway-specific transaction ID
  channel        String?  // card, bank_transfer, ussd, mobile_money
  paidAt         DateTime?
  metadata       Json?    // Gateway-specific metadata (card type, last4, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Performance indexes for payment queries
  @@index([invoiceId])                 // Lookup payments by invoice
  @@index([status])                    // Filter by payment status
  @@index([gateway])                   // Filter by gateway
  @@index([createdAt])                 // Recent payments
  @@index([status, createdAt])         // Dashboard analytics
  @@index([gatewayRef])                // Lookup by gateway reference
  @@map("payments")
}

model SMSDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  to            String
  messageId     String?
  provider      String
  status        String
  providerPayload Json   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Performance indexes for SMS tracking
  @@index([to])                        // Lookup by recipient
  @@index([status])                    // Filter by delivery status
  @@index([messageId])                 // Lookup by provider message ID
  @@index([createdAt])                 // Recent messages
  @@map("sms_deliveries")
}

model Alert {
  id             String    @id
  type           String
  severity       String
  title          String
  message        String    @db.Text
  timestamp      DateTime  @default(now())
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  acknowledgedBy String?
  acknowledgedAt DateTime?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Performance indexes for alert monitoring
  @@index([type, severity, resolved])         // Combined filter for dashboard
  @@index([resolved, timestamp])              // Active alerts by recency
  @@index([severity])                         // Filter by severity level
  @@map("alerts")
}

model UserConsent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  consentType String
  granted     Boolean  @default(false)
  grantedAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, consentType], map: "user_consent_unique")
  @@index([consentType])
  @@map("user_consents")
}

// ============================================
// Device Sync Models
// ============================================

model Device {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  deviceId       String   @unique @map("device_id") // Client-generated device identifier
  platform       String   // android, ios, web
  appVersion     String   @map("app_version")
  osVersion      String?  @map("os_version")
  locale         String?
  lastSeenAt     DateTime @map("last_seen_at")
  lastHeartbeat  DateTime @map("last_heartbeat") // Alias for compatibility
  network        String?  // online, offline
  batteryPct     Int?     @map("battery_pct")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User       @relation(fields: [userId], references: [id])
  syncJobs       SyncJob[]
  conflicts      Conflict[]

  @@index([userId])
  @@index([deviceId])
  @@index([active, lastHeartbeat])
  @@index([lastSeenAt])
  @@index([userId, lastSeenAt])
  @@map("devices")
}

model SyncJob {
  id            String    @id @default(uuid()) @db.Uuid
  deviceId      String    @map("device_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  invoiceId     String?   @map("invoice_id") @db.Uuid
  clientId      String    @map("client_id")
  entity        String    // invoice, payment, receipt, settings, profile
  action        String    // create, update, delete
  operation     String    // push, pull, conflict_resolve
  clientVersion Int       @map("client_version")
  payload       Json
  status        String    @default("pending") // pending, processing, synced, failed, conflict
  result        Json?
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.Text
  syncedAt      DateTime? @map("synced_at")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  device        Device    @relation(fields: [deviceId], references: [id])
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id])

  @@index([deviceId])
  @@index([userId])
  @@index([deviceId, status])
  @@index([status])
  @@index([status, attempts])
  @@index([status, createdAt])
  @@index([operation, status])
  @@index([entity, action])
  @@index([createdAt])
  @@map("sync_jobs")
}

model Conflict {
  id              String    @id @default(uuid()) @db.Uuid
  invoiceId       String    @map("invoice_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  localVersion    Int       @map("local_version")
  serverVersion   Int       @map("server_version")
  localData       Json      @map("local_data")
  serverData      Json      @map("server_data")
  status          String    @default("PENDING") // PENDING, RESOLVED_CLIENT, RESOLVED_SERVER, RESOLVED_MANUAL
  resolution      String?
  resolvedBy      String?   @map("resolved_by")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  device          Device    @relation(fields: [deviceId], references: [id])

  @@index([invoiceId])
  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([resolution])
  @@index([createdAt])
  @@map("conflicts")
}

model InvoiceVersion {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  version     Int
  data        Json
  changedBy   String?  @map("changed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  invoice     Invoice  @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, version])
  @@index([invoiceId])
  @@index([createdAt])
  @@map("invoice_versions")
}

model OCRJob {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  imageUri    String   @map("image_uri") @db.Text
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  result      Json?
  error       String?  @db.Text
  confidence  Float?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("ocr_jobs")
}

// ============================================
// Payroll (Phase 6)
// ============================================

model Payroll {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  period          String        // e.g. "2026-02"
  status          String        @default("draft") // draft, processing, completed, cancelled
  totalGross      Decimal       @default(0) @db.Decimal(15, 2) @map("total_gross")
  totalNet        Decimal       @default(0) @db.Decimal(15, 2) @map("total_net")
  totalTax        Decimal       @default(0) @db.Decimal(15, 2) @map("total_tax")
  totalPension    Decimal       @default(0) @db.Decimal(15, 2) @map("total_pension")
  totalNHF        Decimal       @default(0) @db.Decimal(15, 2) @map("total_nhf")
  employeeCount   Int           @default(0) @map("employee_count")
  processedBy     String?       @map("processed_by") @db.Uuid
  processedAt     DateTime?     @map("processed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  items           PayrollItem[]

  @@unique([businessId, period])
  @@index([businessId])
  @@index([status])
  @@index([period])
  @@map("payrolls")
}

model PayrollItem {
  id                  String    @id @default(uuid()) @db.Uuid
  payrollId           String    @map("payroll_id") @db.Uuid
  employeeId          String    @map("employee_id") @db.Uuid
  grossSalary         Decimal   @db.Decimal(15, 2) @map("gross_salary")
  totalAllowances     Decimal   @default(0) @db.Decimal(15, 2) @map("total_allowances")
  grossIncome         Decimal   @db.Decimal(15, 2) @map("gross_income")
  pensionContribution Decimal   @default(0) @db.Decimal(15, 2) @map("pension_contribution")
  nhfContribution     Decimal   @default(0) @db.Decimal(15, 2) @map("nhf_contribution")
  taxableIncome       Decimal   @default(0) @db.Decimal(15, 2) @map("taxable_income")
  payeTax             Decimal   @default(0) @db.Decimal(15, 2) @map("paye_tax")
  netPay              Decimal   @db.Decimal(15, 2) @map("net_pay")
  breakdown           Json      @default("[]")
  createdAt           DateTime  @default(now()) @map("created_at")

  payroll             Payroll   @relation(fields: [payrollId], references: [id])

  @@index([payrollId])
  @@index([employeeId])
  @@map("payroll_items")
}

// ============================================
// Compliance Reminders (Phase 6)
// ============================================

model ComplianceReminder {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  taxType         String    @map("tax_type") // VAT, PAYE, CIT, WHT, PIT
  dueDate         DateTime  @map("due_date")
  amount          Decimal?  @db.Decimal(15, 2)
  status          String    @default("pending") // pending, filed, overdue, dismissed
  priority        String    @default("medium") // low, medium, high, critical
  description     String
  notifiedAt      DateTime? @map("notified_at")
  filedAt         DateTime? @map("filed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([taxType])
  @@index([status])
  @@index([dueDate])
  @@index([businessId, status])
  @@map("compliance_reminders")
}

// ============================================
// Crypto Transactions (Phase 6)
// ============================================

model CryptoTransaction {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  type            String    // buy, sell, trade, transfer
  asset           String    // BTC, ETH, USDT, etc.
  amount          Decimal   @db.Decimal(18, 8) // crypto amount (high precision)
  priceNGN        Decimal   @db.Decimal(15, 2) @map("price_ngn") // price in NGN
  totalNGN        Decimal   @db.Decimal(15, 2) @map("total_ngn") // total value in NGN
  costBasis       Decimal?  @db.Decimal(15, 2) @map("cost_basis")
  platform        String?   // Binance, Luno, Quidax, etc.
  txHash          String?   @map("tx_hash")
  date            DateTime
  taxYear         Int       @map("tax_year")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([asset])
  @@index([type])
  @@index([taxYear])
  @@index([businessId, taxYear])
  @@map("crypto_transactions")
}

model AdminAction {
  id          String   @id @default(uuid()) @db.Uuid
  adminId     String   @map("admin_id") @db.Uuid
  action      String   // force_sync, resolve_conflict, reset_device
  targetId    String?  @map("target_id") @db.Uuid
  targetType  String?  @map("target_type") // device, user, invoice
  metadata    Json     @default("{}")
  result      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  admin       User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_actions")
}

// ============================================
// Anomaly Records — Module 1 (V3.0)
// ============================================

model AnomalyRecord {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  signal           String   // duplicate_amount, zscore_spike, vat_mismatch, etc.
  severity         String   // critical, high, medium, low, informational
  confidence       Float    @default(0)
  dismissed        Boolean  @default(false)
  dismissedAt      DateTime? @map("dismissed_at")
  relatedEntityId  String?  @map("related_entity_id") // invoiceId, expenseId, etc.
  relatedEntityType String? @map("related_entity_type") // invoice, expense
  metadata         Json     @default("{}")
  explanationEn    String?  @db.Text @map("explanation_en")
  explanationPidgin String? @db.Text @map("explanation_pidgin")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([severity, dismissed])
  @@index([businessId])
  @@index([signal])
  @@map("anomaly_records")
}

// ============================================
// Tax Health Snapshots — Module 3 (V3.0)
// ============================================

model TaxHealthSnapshot {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  businessId           String?  @map("business_id") @db.Uuid
  totalScore           Float    @map("total_score")
  grade                String   // excellent, good, fair, poor, critical
  filingTimeliness     Float    @map("filing_timeliness")
  dataCompleteness     Float    @map("data_completeness")
  complianceCalendar   Float    @map("compliance_calendar")
  nrsSubmissions       Float    @map("nrs_submissions")
  paymentHistory       Float    @map("payment_history")
  trend                String?  // improving, stable, declining
  computedAt           DateTime @default(now()) @map("computed_at")

  @@index([userId, computedAt])
  @@index([businessId])
  @@index([grade])
  @@map("tax_health_snapshots")
}

// ============================================
// Vendor Records — Module 1 phantom vendor (V3.0)
// ============================================

model VendorRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  tin          String?  @unique
  rcNumber     String?  @map("rc_number")
  sector       String?
  riskLevel    String   @default("unknown") @map("risk_level") // low, medium, high, unknown
  verified     Boolean  @default(false)
  verifiedAt   DateTime? @map("verified_at")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([userId])
  @@index([riskLevel])
  @@map("vendor_records")
}

// ============================================
// Compliance Streak — M09 F3 (V3.1)
// ============================================

model StreakRecord {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  currentStreak     Int       @default(0) @map("current_streak")
  longestStreak     Int       @default(0) @map("longest_streak")
  totalXP           Int       @default(0) @map("total_xp")
  lastCheckinDate   DateTime? @map("last_checkin_date")
  lastResetReason   String?   @map("last_reset_reason") // invoice_missed, manual_reset
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([currentStreak])
  @@map("streak_records")
}

// ============================================
// Pillar Scores — M09 F1 Health Ring (V3.1)
// ============================================

// pillar values: filing_timeliness | data_completeness | compliance_calendar | nrs_submissions
model PillarScore {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  businessId   String?  @map("business_id") @db.Uuid
  pillar       String   // filing_timeliness, data_completeness, compliance_calendar, nrs_submissions
  score        Float    // 0–100
  trend        String?  // improving, stable, declining
  computedAt   DateTime @default(now()) @map("computed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, pillar])
  @@index([userId, computedAt])
  @@index([businessId])
  @@map("pillar_scores")
}

// ============================================
// Filing Status Enum (NTA 2025 §3)
// ============================================

enum FilingStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

// ============================================
// Onboarding Progress — V11.0 P2
// ============================================

model OnboardingProgress {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  step              String    @default("welcome") // welcome, profile, business, tin, first_invoice, complete
  completedSteps    String[]  @default([]) @map("completed_steps")
  skippedSteps      String[]  @default([]) @map("skipped_steps")
  completedAt       DateTime? @map("completed_at")
  lastStepAt        DateTime? @map("last_step_at")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([step])
  @@map("onboarding_progress")
}

// ============================================
// DLQ Jobs — V11.0 P2 (Dead Letter Queue persistence)
// ============================================

model DLQJob {
  id              String    @id @default(uuid()) @db.Uuid
  queueName       String    @map("queue_name")
  jobId           String    @map("job_id")
  payload         Json
  failedReason    String    @db.Text @map("failed_reason")
  attemptsMade    Int       @map("attempts_made")
  maxAttempts     Int       @default(5) @map("max_attempts")
  status          String    @default("failed") // failed, retrying, resolved, discarded
  resolvedBy      String?   @map("resolved_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at")
  idempotencyKey  String?   @unique @map("idempotency_key")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([queueName, status])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@map("dlq_jobs")
}

// ============================================
// User Sessions — V11.0 P3 (Session invalidation for RBAC)
// ============================================

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  deviceId        String?   @map("device_id")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent") @db.Text
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  revokedBy       String?   @map("revoked_by") @db.Uuid
  revokeReason    String?   @map("revoke_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("user_sessions")
}

// ============================================
// Academy Nudge — V11.0 P7 (Tax education nudges)
// ============================================

model AcademyNudge {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  nudgeKey        String    @map("nudge_key") // vat_basics, pit_bands, nrs_stamps, dev_levy, wht_rules
  title           String
  titlePidgin     String    @map("title_pidgin")
  body            String    @db.Text
  bodyPidgin      String    @map("body_pidgin") @db.Text
  dismissed       Boolean   @default(false)
  dismissedAt     DateTime? @map("dismissed_at")
  shownCount      Int       @default(0) @map("shown_count")
  lastShownAt     DateTime? @map("last_shown_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, nudgeKey])
  @@index([userId, dismissed])
  @@index([nudgeKey])
  @@map("academy_nudges")
}
