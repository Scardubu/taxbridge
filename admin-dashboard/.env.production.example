# TaxBridge Admin Dashboard - Production Environment
# Copy to .env.production for production builds

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL (required)
BACKEND_URL=https://taxbridge-api-ker8.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://taxbridge-api-ker8.onrender.com
NEXT_PUBLIC_API_URL=https://taxbridge-api-ker8.onrender.com

# App Metadata
NEXT_PUBLIC_APP_NAME=TaxBridge
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# AUTHENTICATION (NextAuth.js)
# =============================================================================
NEXTAUTH_URL=https://taxbridge.vercel.app
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
DATABASE_URL=postgresql://taxbridge_user:PASSWORD@HOST:5432/taxbridge_production
ADMIN_AUTH_ENFORCE=true

# Server-only credentials. Never use NEXT_PUBLIC_ for these values.
INTERNAL_API_KEY=REPLACE_WITH_SERVER_ONLY_INTERNAL_KEY_MIN_32_CHARS
ADMIN_API_KEYS=REPLACE_WITH_SERVER_ONLY_ADMIN_API_KEY_MIN_32_CHARS
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_ENCODED_RS256_SPKI_PUBLIC_PEM

# =============================================================================
# ERROR TRACKING (Sentry)
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxxx.ingest.sentry.io/xxxxxxx
SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# ANALYTICS
# =============================================================================
# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Analytics Features
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
NEXT_PUBLIC_FEATURE_PAYROLL=true
NEXT_PUBLIC_FEATURE_COMPLIANCE=true
NEXT_PUBLIC_FEATURE_CRYPTO=true
NEXT_PUBLIC_FEATURE_RECONCILIATION=true
NEXT_PUBLIC_FEATURE_BULK_OPERATIONS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_FEATURE_ANALYTICS=true

# =============================================================================
# PAYMENT GATEWAYS (Public Keys)
# =============================================================================
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# MAP & LOCATION (Google Maps)
# =============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
