# TaxBridge Admin Dashboard — local development defaults
# Deployment environments must define their own server-only backend origin,
# signing public key, internal API key and administrator API keys.
# Never place secrets in NEXT_PUBLIC_* variables.

# API origins: use the local/staging backend during local development.
BACKEND_API_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Authentication — server-only values.
ADMIN_AUTH_ENFORCE=true
JWT_PUBLIC_KEY=BASE64_ENCODED_RS256_SPKI_PUBLIC_PEM
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_SERVER_ONLY_KEY_MIN_32_CHARS
ADMIN_API_KEYS=REPLACE_WITH_RANDOM_SERVER_ONLY_KEY_MIN_32_CHARS

# Next.js local environment.
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Optional local observability; leave unset until a real project DSN is supplied.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
