# TaxBridge Admin Dashboard - Environment Variables
# Copy this file to .env.local for local development

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================

# Backend API URL (production default set in next.config.ts)
# Local dev: http://localhost:3001
# Staging: https://taxbridge-api-staging.onrender.com  
# Production: https://taxbridge-api-ker8.onrender.com
BACKEND_URL=https://taxbridge-api-ker8.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://taxbridge-api-ker8.onrender.com

# ============================================================================
# ADMIN AUTHENTICATION
# ============================================================================

# Admin API keys (comma-separated for key rotation)
# Generate with: openssl rand -base64 32
# Must match ADMIN_API_KEYS in backend environment
ADMIN_API_KEYS=your-admin-key-1,your-admin-key-2

# WARNING: NEXT_PUBLIC_* is exposed to browser
# Use NEXT_PUBLIC_ADMIN_API_KEY only for read-only operations
# Admin mutations should use server actions (Phase 8 recommendation)
NEXT_PUBLIC_ADMIN_API_KEY=your-readonly-admin-key

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Node environment (development | production)
NODE_ENV=production

# Next.js telemetry (disable for privacy)
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# NOTES
# ============================================================================

# 1. Never commit .env.local to version control
# 2. Admin API keys must be 32+ characters for security
# 3. BACKEND_URL must NOT have trailing slash
# 4. Production keys managed via Vercel Dashboard
# 5. Local dev requires backend running on localhost:3001
# 6. NEXT_PUBLIC_ADMIN_API_KEY is exposed to browser - use for read-only only
# 7. Phase 8 recommendation: Move admin mutations to Next.js server actions
