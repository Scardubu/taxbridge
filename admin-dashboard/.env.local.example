# TaxBridge Admin Dashboard Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# BACKEND API
# =============================================================================
# Development
BACKEND_URL=http://localhost:3000

# Production
# BACKEND_URL=https://api.taxbridge.ng

# Admin API key for authenticated endpoints
# Used for server-side API calls (not exposed to browser)
ADMIN_API_KEY=your-admin-api-key

# Optional: comma-separated list of admin keys for rotation/fallback
# ADMIN_API_KEYS=primary-admin-key,secondary-admin-key

# WARNING: NEXT_PUBLIC_* is exposed to browser JavaScript
# Use only for read-only operations (device diagnostics, conflict viewing)
# Admin mutations (conflict resolution) should use server actions
NEXT_PUBLIC_ADMIN_API_KEY=your-readonly-admin-key

# =============================================================================
# NEXT.JS SETTINGS
# =============================================================================
# Enable telemetry (optional)
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# NOTES
# =============================================================================
# 1. Admin dashboard only needs BACKEND_URL and admin API keys
# 2. DUPLO/REMITA credentials are backend-only (not needed here)
# 3. NEXT_PUBLIC_ADMIN_API_KEY is exposed to browser - use with caution
# 4. For production, set these in Vercel Dashboard environment variables
