# TaxBridge Staging Environment Configuration
# Copy this to .env.staging and fill in actual values
# DO NOT COMMIT .env.staging TO GIT

# Environment
NODE_ENV=staging
PORT=3001

# Database (Supabase Staging)
DATABASE_URL=postgresql://user:password@staging-db.supabase.co:5432/taxbridge_staging

# Redis (Upstash Staging)
REDIS_URL=redis://default:password@staging-redis.upstash.io:6379

# External Integrations (Sandbox/Test Modes)
# DigiTax (e-Invoicing) - Sandbox
# Note: Backend uses DIGITAX_API_URL + DUPLO_CLIENT_ID/SECRET (not DIGITAX_CLIENT_*)
DIGITAX_API_URL=https://sandbox.digitax.ng/api/v1
DIGITAX_API_KEY=staging_api_key
DIGITAX_HMAC_SECRET=staging_hmac_secret
DIGITAX_MOCK_MODE=true

# Duplo (NITDA-accredited APP for NRS e-invoicing)
DUPLO_CLIENT_ID=staging_client_id
DUPLO_CLIENT_SECRET=staging_client_secret

# Remita (Payments) - Test Environment
REMITA_API_URL=https://remitademo.net/remita
REMITA_MERCHANT_ID=test_merchant_id
REMITA_API_KEY=test_api_key
REMITA_SERVICE_TYPE_ID=test_service_type
REMITA_WEBHOOK_SECRET=test_webhook_secret
REMITA_MOCK_MODE=true

# Africa's Talking (SMS) - Sandbox
# Note: Backend uses AT_API_KEY, AT_USERNAME, AT_SHORTCODE
AT_USERNAME=sandbox
AT_API_KEY=sandbox_api_key
AT_SHORTCODE=TAXBRIDGE
AT_SANDBOX_MODE=true

# Monitoring & Analytics
# Sentry (Error Tracking)
SENTRY_DSN=https://staging@sentry.io/project
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# Mixpanel (User Analytics)
MIXPANEL_TOKEN=staging_mixpanel_token
MIXPANEL_DEBUG=true

# Admin Dashboard
# Comma-separated for key rotation (backend validates X-Admin-API-Key header)
ADMIN_API_KEYS=staging_admin_api_key_change_in_production
ADMIN_DASHBOARD_URL=https://admin-staging.taxbridge.ng

# JWT & Security
JWT_SECRET=staging_jwt_secret_min_32_characters_random
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://admin-staging.taxbridge.ng,https://staging.taxbridge.ng

# Rate Limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=60000

# ML Model (Optional - use heuristic if not available)
ML_MODEL_PATH=ml/models/churn_model_tfjs/model.json
ML_ENABLED=false

# Email (Development - Mailtrap or similar)
EMAIL_PROVIDER=mailtrap
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=staging_email_user
EMAIL_PASSWORD=staging_email_password
EMAIL_FROM=noreply@staging.taxbridge.ng

# Mobile App
# Mobile uses EXPO_PUBLIC_API_URL (set in mobile/.env)
EXPO_PUBLIC_API_URL=https://api-staging.taxbridge.ng
MOBILE_DEEP_LINK_SCHEME=taxbridge-staging

# Feature Flags
ENABLE_GROWTH_CAMPAIGNS=true
ENABLE_NPS_SURVEYS=true
ENABLE_CHURN_PREDICTION=true
ENABLE_REFERRAL_PROGRAM=true
FEATURE_DEVICE_SYNC=true

# Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5000

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Backup & Recovery
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"

# Performance
CACHE_TTL=300
COMPRESSION_ENABLED=true

# Regulatory Compliance
NDPC_AUDIT_ENABLED=true
DATA_RETENTION_DAYS=365
