{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemas": {
    "HeartbeatSchema": {
      "type": "object",
      "required": [
        "deviceId",
        "platform",
        "appVersion"
      ],
      "properties": {
        "deviceId": {
          "type": "string"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "platform": {
          "enum": [
            "android",
            "ios",
            "web"
          ]
        },
        "appVersion": {
          "type": "string"
        },
        "osVersion": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "network": {
          "enum": [
            "online",
            "offline"
          ]
        },
        "batteryPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "SyncJobSchema": {
      "type": "object",
      "required": [
        "clientId",
        "entity",
        "action",
        "clientVersion",
        "payload",
        "createdAt"
      ],
      "properties": {
        "clientId": {
          "type": "string"
        },
        "entity": {
          "enum": [
            "invoice",
            "payment",
            "expense",
            "receipt",
            "settings",
            "profile"
          ]
        },
        "action": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "clientVersion": {
          "type": "integer",
          "minimum": 0
        },
        "payload": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PushSyncSchema": {
      "type": "object",
      "required": [
        "deviceId",
        "jobs",
        "clientTime"
      ],
      "properties": {
        "deviceId": {
          "type": "string"
        },
        "jobs": {
          "type": "array",
          "minItems": 1
        },
        "clientTime": {
          "type": "string",
          "format": "date-time"
        },
        "lastSyncAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "OperationEnvelopeSchema": {
      "type": "object",
      "required": [
        "operationId",
        "idempotencyKey",
        "operationType",
        "schemaVersion",
        "payload",
        "createdAt"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 16,
          "maxLength": 200
        },
        "operationType": {
          "enum": [
            "crud",
            "sync",
            "payment",
            "filing"
          ]
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
